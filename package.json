{
  "name": "yapi-to-typescript",
  "version": "4.0.0",
  "description": "根据 YApi 的接口定义生成 TypeScript/JavaScript 的接口类型及其请求函数代码。",
  "keywords": [
    "yapi",
    "codegen",
    "typescript"
  ],
  "homepage": "https://github.com/fjc0k/yapi-to-typescript",
  "bugs": {
    "url": "https://github.com/fjc0k/yapi-to-typescript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:fjc0k/yapi-to-typescript.git"
  },
  "license": "MIT",
  "author": {
    "name": "Jay Fong",
    "email": "fjc0kb@gmail.com",
    "url": "https://github.com/fjc0k"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.mjs",
    "./cli": "./lib/cli.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "ytt": "./lib/cli.mjs"
  },
  "files": [
    "lib"
  ],
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run --coverage",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "test:api": "tsx src/cli.ts",
    "docs": "pnpm run docs:build && gh-pages --dist docs/dist --dest v4",
    "docs:build": "dumi build",
    "docs:dev": "dumi dev",
    "release": "pnpm run test:run && standard-version -a && pnpm run build && pnpm run docs && git push --follow-tags origin master && npm login && npm publish",
    "release:beta": "pnpm run test:run && standard-version -a --release-as patch --prerelease beta && pnpm run build && git push --follow-tags origin master && npm login && npm publish --tag next",
    "release:major": "pnpm run test:run && standard-version -a --release-as major && pnpm run build && git push --follow-tags origin master && npm login && npm publish",
    "release:major:beta": "pnpm run test:run && standard-version -a --release-as major --prerelease beta && pnpm run build && git push --follow-tags origin master && npm login && npm publish --tag next",
    "prepare": "dumi setup"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "change-case": "^5.4.4",
    "consola": "^3.4.2",
    "dayjs": "^1.11.23",
    "form-data": "^4.0.6",
    "fs-extra": "^11.4.1",
    "get-port": "^7.2.0",
    "jiti": "^2.7.0",
    "json-schema-to-typescript": "^16.0.0",
    "json5": "^2.2.3",
    "node-fetch": "^3.3.2",
    "ora": "^10.0.0",
    "prettier": "^3.10.1",
    "prompts": "^2.4.2",
    "proxy-agent": "^8.0.2",
    "signal-exit": "^4.1.0",
    "swagger-client": "3.18.4",
    "to-json-schema": "^0.2.5",
    "typescript": "^6.0.3",
    "vtils": "^4.138.0",
    "yargs": "^18.2.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/fs-extra": "^11.0.4",
    "@types/json5": "^2.2.0",
    "@types/node": "^24.19.2",
    "@types/prompts": "^2.4.9",
    "@types/react": "^16.9.2",
    "@types/to-json-schema": "^0.2.4",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.1.0",
    "codecov": "^3.8.3",
    "dumi": "^2.4.57",
    "gh-pages": "^6.3.0",
    "notify-dingtalk": "^1.2.0",
    "standard-version": "^9.5.0",
    "tempy": "^3.2.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
