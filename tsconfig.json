{
  "compilerOptions": {
    "strict": true,
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "newLine": "LF",
    "skipLibCheck": true,
    "types": ["*"],
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@@/*": ["./.dumi/tmp/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    ".dumirc.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
